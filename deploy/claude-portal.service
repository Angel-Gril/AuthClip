[Unit]
Description=Claude access desk
After=network.target

[Service]
User=claude-portal
Group=claude-portal
WorkingDirectory=/opt/claude-portal
StateDirectory=claude-portal
StateDirectoryMode=0700
Environment=PORTAL_GEO_DB=/opt/claude-portal/geo/country.mmdb
Environment=PORTAL_TRUSTED_PROXY=127.0.0.1/32
ExecStart=/opt/claude-portal/portal serve --http=127.0.0.1:8090 --dir=/var/lib/claude-portal
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
